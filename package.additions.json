{
  "_comment": "What setup.sh adds. Versions verified on 2026-09-24. jest and @types/jest are only added when the project has no Jest yet.",
  "scripts": {
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.cjs --passWithNoTests"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@testcontainers/mysql": "^12.1.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "eslint-plugin-jest": "^29.16.0",
    "jest": "^30.5.0",
    "msw": "^2.15.0",
    "mysql2": "^3.24.0",
    "supertest": "^7.3.0"
  }
}
